# Copy to .env and fill in your own values. .env is git-ignored; never commit real credentials here.

# OpenSky Network API credentials (optional)
# Sign up at https://opensky-network.org for better rate limits; anonymous access works without them.
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# Flask server settings
DEBUG=True
HOST=0.0.0.0
PORT=5001

# Mistral AI configuration (needed for the Mistral agent)
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Backend URL the Mistral agent calls (local development default)
BACKEND_URL=http://localhost:5001
